# ============================================================================
# UniAssist 360 - Local Environment Configuration Template
# ============================================================================
# Copy this file to .env in the project root (or BackEnd directory) for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# - NEVER commit your .env file or real credentials to source control.
# - The .env file is git-ignored by default.
# ============================================================================

# ─── Database Configuration ──────────────────────────────────────────────────
# DB_URL=jdbc:mysql://localhost:3306/helpdesk_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# DB_USERNAME=root
# DB_PASSWORD=your_database_password

# ─── JWT Authentication ──────────────────────────────────────────────────────
# Generate a strong 64+ char secret for production: openssl rand -base64 64
JWT_SECRET=defaultSecretKeyForDevelopmentOnlyPleaseChangeInProductionEnvironment1234567890

# ─── Bootstrap Administrator (clean installation only) ───────────────────────
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_EMAIL=admin@localhost
# BOOTSTRAP_ADMIN_PASSWORD=your_initial_admin_password

# ─── Gemini AI Key (Chatbot & KB Assistance) ───────────────────────────────────
# GEMINI_API_KEY=your_gemini_api_key

# ─── SMTP Email Delivery Configuration ───────────────────────────────────────
# Set EMAIL_ENABLED=true to activate email delivery for password reset and notifications.
EMAIL_ENABLED=false

# SMTP Server Connection Settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-account@example.com
SMTP_PASSWORD=your-smtp-password-or-app-password

# Sender Address (defaults to SMTP_USERNAME if omitted)
SMTP_FROM=your-smtp-account@example.com

# SMTP Security & Protocol Settings
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
SMTP_SSL=false
SMTP_TIMEOUT=5000

# ─── Frontend Integration ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
